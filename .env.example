# Environment Variables for AI Personal Trainer API

# REQUIRED: Google Gemini API Key
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_api_key_here

# OPTIONAL: Server configuration
# Port (default: 8080, Cloud Run sets this automatically)
PORT=8080

# Host binding (default: 0.0.0.0, suitable for containers)
HOST=0.0.0.0

# Number of Uvicorn workers (default: 1)
# Increase for parallel request handling if needed
WORKERS=1

# OPTIONAL: Logging
# Log level (default: INFO)
LOG_LEVEL=INFO
